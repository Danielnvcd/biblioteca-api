# TEST DUMMY — la location /_protected/ es un return 200 simple.
# Para verificar si el matching de la location funciona, sin la complicación
# de `alias` ni `internal`.
#
# Si responde "PROTECTED MATCHED" → la location matchea, el bug original era
#   de alias/permisos.
# Si responde 401 con JSON → la location NO matchea, el bug es de routing.

upstream biblioteca_api {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 127.0.0.1:80;
    server_name api.bibliotecamaxipet.cloud;

    proxy_connect_timeout 30s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    access_log /var/log/nginx/biblioteca-api.access.log;
    error_log  /var/log/nginx/biblioteca-api.error.log warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options         "DENY"   always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # TEST DUMMY
    location /_protected/ {
        default_type text/plain;
        return 200 "PROTECTED MATCHED\n";
    }

    location / {
        proxy_pass         http://biblioteca_api;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
    }
}
