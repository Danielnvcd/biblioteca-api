# =============================================================================
# Plantilla de configuración. Copiar a .env y completar:
#
#   cp .env.example .env
#
# .env está en .gitignore; ESTE archivo no, así que nunca pongas acá un valor
# real. Los que dicen "generar" hay que generarlos: no uses los de ejemplo ni
# copies los de otro entorno.
#
# Levantar el stack:
#   docker compose up -d --build                                  (servidor)
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build   (esta máquina)
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Con lo que crea el contenedor de Postgres la primera vez que arranca. Cambiar
# POSTGRES_PASSWORD después del primer arranque NO cambia la contraseña real:
# el volumen ya está inicializado y habría que alterarla dentro de la base.
POSTGRES_DB=biblioteca_maxipet
POSTGRES_USER=bibliotecario
# generar: openssl rand -base64 24
POSTGRES_PASSWORD=

# Separación de privilegios (opcional, recomendado en producción).
#
# Las migraciones necesitan DDL (CREATE/ALTER TABLE); la aplicación en marcha
# solo necesita DML. Mientras las dos usen el mismo rol, ese rol puede
# reescribir el esquema en cada request — y el peor día de un bug de inyección
# deja de ser "leer datos" para pasar a ser "DROP TABLE".
#
# Sin definirlas, ambas caen al usuario de arriba y el comportamiento es el de
# siempre. Ver docs/DB-LEAST-PRIVILEGE.md.
# DB_USERNAME=biblioteca_app
# DB_PASSWORD=
# DB_MIGRATION_USERNAME=bibliotecario
# DB_MIGRATION_PASSWORD=

# Solo hace falta si corrés la aplicación FUERA de docker: dentro del stack la
# arma docker-compose a partir de POSTGRES_DB.
# DATABASE_URL=jdbc:postgresql://localhost:5432/biblioteca_maxipet
# DB_SCHEMA=public


# -----------------------------------------------------------------------------
# Secretos — sin estos la aplicación NO arranca en el perfil prod
# -----------------------------------------------------------------------------
# ProdSecretsValidator se niega a levantar si detecta los valores de desarrollo,
# para que activar prod sin definir estas variables falle de entrada en vez de
# quedar sirviendo con una clave que está publicada en el repositorio.

# Firma de los JWT. Rotarlo invalida todas las sesiones abiertas (todo el mundo
# vuelve a iniciar sesión), pero no se pierde ningún dato.
# generar: openssl rand -base64 64
JWT_SECRET=

# Cifra en reposo los secretos TOTP del 2FA (AES-256-GCM) y firma los códigos
# que se mandan por correo. Tiene que ser Base64 de exactamente 32 bytes.
#
# CUIDADO AL ROTARLA: los secretos TOTP guardados quedan indescifrables y todo
# el que tenga 2FA por app pierde el acceso — habría que resetearles el 2FA uno
# por uno desde una cuenta de super_admin. No la cambies sin un plan.
# generar: openssl rand -base64 32
APP_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Orígenes del frontend, separados por coma y SIN barra final. Tienen que ser
# exactos (esquema + host + puerto): el navegador compara la cadena completa.
# No admite comodines — la API manda cookies, y credenciales con origen abierto
# es justo la combinación que permite que cualquier sitio hable por el usuario.
CORS_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# Límite de peticiones
# -----------------------------------------------------------------------------
# backend=memory alcanza con UNA sola instancia. Con varias, cada una lleva su
# propio contador y el límite efectivo pasa a ser N × el configurado, así que
# ahí hay que usar redis.
#
# Si Redis no responde, el filtro DEJA PASAR la petición y avisa por log: el
# bloqueo por cuenta (que vive en Postgres) sigue cubriendo la fuerza bruta.
# Quedarse sin limitador degrada la protección; quedarse sin login la elimina
# junto con el resto del sistema.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
SPRING_DATA_REDIS_URL=redis://redis:6379

# Poner en true SOLO si de verdad estás corriendo Redis: si no, el health check
# reporta la aplicación como caída por un servicio que nadie levantó.
MANAGEMENT_HEALTH_REDIS_ENABLED=true


# -----------------------------------------------------------------------------
# Correo (Resend) — códigos de acceso y avisos de inicio de sesión
# -----------------------------------------------------------------------------
# Con MAIL_ENABLED=false el sistema levanta igual y los flujos que dependen del
# correo responden "no configurado" en vez de fallar al enviar.
#
# En true, ProdSecretsValidator exige RESEND_API_KEY y MAIL_FROM y se niega a
# arrancar sin ellos. Es a propósito: el correo activado y roto falla en
# silencio, y los avisos de intrusión no llegarían sin que nadie lo note.
MAIL_ENABLED=false

# Clave de https://resend.com/api-keys
RESEND_API_KEY=

# Remitente. Tiene que ser del dominio verificado en Resend (SPF/DKIM), o los
# mensajes van a spam o directamente los rechazan. Admite las dos formas:
#   no-reply@tu-dominio.com
#   Biblioteca Maxipet <no-reply@tu-dominio.com>
MAIL_FROM=

MAIL_APP_NAME=Biblioteca Maxipet

# URL pública del FRONTEND. De acá salen el logo de los correos
# (APP_PUBLIC_URL/logo.png) y el botón "Ir a mi perfil".
#
# En producción tiene que ser el dominio real: con un localhost acá, quien
# reciba el correo no puede resolver esa dirección y el logo llega roto. Si se
# deja vacío, los correos salen sin logo ni botón, pero siguen siendo válidos.
APP_PUBLIC_URL=http://localhost:5173

# Solo para apuntar a un servidor de pruebas en vez de a Resend.
# MAIL_BASE_URL=https://api.resend.com


# -----------------------------------------------------------------------------
# Opcionales
# -----------------------------------------------------------------------------
# Dentro de docker ya viene fijado por el Dockerfile (/app/uploads).
# UPLOAD_DIR=./uploads

# Vida de los tokens, en milisegundos. Los valores por defecto son 15 min de
# access y 7 días de refresh (rotando en cada uso). Subir el primero alarga la
# ventana en la que un token robado sigue sirviendo.
# JWT_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=604800000
