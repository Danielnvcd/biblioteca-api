# /etc/nginx/sites-available/biblioteca-api
#
# Topología (Cloudflare Tunnel):
#   Cliente ──HTTPS──► Cloudflare ──Tunnel──► cloudflared (en el VPS)
#                                                  │
#                                                  ▼ (127.0.0.1)
#                                            nginx (127.0.0.1:80)
#                                                  │
#                                                  ▼
#                                          Spring Boot (127.0.0.1:8080)
#
# Dominio público: api.bibliotecamaxipet.cloud (gestionado por el Tunnel, no DNS).
#
# Implicancias:
#   - El puerto 80 NO necesita estar expuesto al mundo: cloudflared conecta
#     localmente. Bindeamos nginx solo a 127.0.0.1 para que ni siquiera
#     escuche en interfaces públicas.
#   - Las requests llegan a nginx desde 127.0.0.1. Para que $remote_addr
#     refleje la IP real del cliente (necesario para el rate-limit de Spring),
#     /etc/nginx/nginx.conf debe tener `set_real_ip_from 127.0.0.1` además del
#     `real_ip_header CF-Connecting-IP` que ya viene definido globalmente.
#   - X-Forwarded-Proto se hardcodea a https porque Cloudflare termina TLS.

upstream biblioteca_api {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    # Solo localhost — cloudflared se conecta acá, no hay tráfico público directo.
    listen 127.0.0.1:80;
    server_name api.bibliotecamaxipet.cloud;

    # Debe coincidir con spring.servlet.multipart.max-file-size en application.yml.
    client_max_body_size 50M;

    proxy_connect_timeout 30s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    access_log /var/log/nginx/biblioteca-api.access.log;
    error_log  /var/log/nginx/biblioteca-api.error.log warn;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types
        application/json
        application/javascript
        text/css
        text/plain
        text/xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options         "DENY"   always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;

    # Health check local (curl http://127.0.0.1/nginx-health desde el VPS).
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        proxy_pass         http://biblioteca_api;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;

        # ⚠️ $remote_addr y NO $proxy_add_x_forwarded_for — este último anexa el
        # X-Forwarded-For que mandó el cliente en vez de reemplazarlo, y Spring
        # toma el PRIMER token de la lista, que sería el elegido por el cliente.
        # Ver el comentario largo en nginx/sites-available/biblioteca-api.
        proxy_set_header   X-Forwarded-For   $remote_addr;

        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
    }
}
