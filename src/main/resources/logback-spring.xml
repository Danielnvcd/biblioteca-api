<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two appenders by profile:
    default (dev) → human-readable single line, includes [requestId]
    prod          → JSON one-event-per-line, ready for log aggregators
                    (ELK / Loki / CloudWatch). MDC (requestId, user) is
                    promoted into top-level JSON fields.

  RequestId is set by RequestIdFilter for every HTTP request.
-->
<configuration>

    <springProfile name="!prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>user</includeMdcKeyName>
                <customFields>{"app":"biblioteca-api"}</customFields>
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.biblioteca" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

</configuration>
